@model WebApplication1.Models.ProductViewModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>Delete Product</h1>
            <hr />

            <div class="alert alert-warning" role="alert">
                <strong>Warning!</strong> Are you sure you want to delete this product? This action cannot be undone.
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Product Name</h6>
                            <p class="h5">@Model.Name</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Price</h6>
                            <p class="h5">$@Model.Price.ToString("F2")</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <h6 class="text-muted">Description</h6>
                            <p>@Model.Description</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Stock Quantity</h6>
                            <p>@Model.StockQuantity</p>
                        </div>
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
